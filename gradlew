#!/bin/sh
# Gradle wrapper stub — bootstrappé via `gradle wrapper --gradle-version 8.9`.
# Sans gradle-wrapper.jar commité, exécutez d'abord : gradle wrapper
APP_BASE_NAME=`basename "$0"`
APP_HOME=`dirname "$0"`
exec java -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
